<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="540.0" prefWidth="560.0" spacing="8.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" stylesheets="../css/estilo.css">
   <padding>
      <Insets bottom="8.0" left="16.0" right="16.0" top="16.0" />
   </padding>
   <children>
      <TitledPane collapsible="false" maxHeight="1.7976931348623157E308" text="Socios que han hecho la ruta" VBox.vgrow="ALWAYS">
         <content>
            <VBox spacing="12.0">
               <padding>
                  <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
               </padding>
               <children>
                  <VBox spacing="4.0">
                     <children>
                        <Label styleClass="etiqueta" text="Ruta (seleccionada en el formulario de rutas)" />
                        <TextField fx:id="tfRuta" editable="false" styleClass="campo-solo-lectura" />
                     </children>
                  </VBox>
                  <VBox spacing="4.0" VBox.vgrow="ALWAYS">
                     <children>
                        <Label styleClass="etiqueta" text="Participantes" />
                        <ListView fx:id="lvParticipantes" VBox.vgrow="ALWAYS" />
                     </children>
                  </VBox>
                  <HBox spacing="8.0">
                     <children>
                        <Button text="Eliminar socio de la ruta"  styleClass="boton-rojo"    onAction="#eliminarSocio"/>
                         <Region HBox.hgrow="ALWAYS" />
                        <Button styleClass="boton-azul" onAction="#volver" text="Volver a rutas" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </content>
      </TitledPane>
      <Label fx:id="lblEstado" minHeight="20.0" styleClass="estado" />
   </children>
</VBox>
