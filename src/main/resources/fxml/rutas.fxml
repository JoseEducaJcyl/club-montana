<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="540.0" prefWidth="760.0" spacing="8.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"  stylesheets="@../css/estilo.css">
   <padding>
      <Insets bottom="8.0" left="16.0" right="16.0" top="16.0" />
   </padding>
   <children>
      <TitledPane collapsible="false" maxHeight="1.7976931348623157E308" text="Rutas del club" VBox.vgrow="ALWAYS">
         <content>
            <VBox spacing="12.0">
               <padding>
                  <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
               </padding>
               <children>
                  <VBox spacing="4.0">
                     <children>
                        <Label styleClass="etiqueta" text="Nombre de la ruta" />
                        <TextField fx:id="tfNombre" />
                     </children>
                  </VBox>
                  <HBox spacing="12.0">
                     <children>
                        <VBox spacing="4.0">
                           <children>
                              <Label styleClass="etiqueta" text="Dificultad" />
                              <ComboBox fx:id="cbDificultad" prefWidth="160.0" />
                           </children>
                        </VBox>
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label styleClass="etiqueta" text="Guía responsable (socio)" />
                              <ComboBox fx:id="cbGuia" maxWidth="1.7976931348623157E308" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>
                  <HBox spacing="8.0">
                     <children>
                        <Button text="Insertar Nuevo"       styleClass="boton-verde"   />
                        <Button text="Modificar Seleccionado" styleClass="boton-naranja" />
                        <Button text="Eliminar Seleccionado"  styleClass="boton-rojo"    />
                        <Button text="Limpiar"              styleClass="boton-gris"    />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button styleClass="boton-azul"  text="Participantes" />
                     </children>
                  </HBox>
                  <TableView fx:id="tblRutas" VBox.vgrow="ALWAYS">
                     <columns>
                        <TableColumn fx:id="colId" maxWidth="60.0" minWidth="40.0" prefWidth="48.0" text="ID" />
                        <TableColumn fx:id="colNombre" prefWidth="260.0" text="Ruta" />
                        <TableColumn fx:id="colDificultad" prefWidth="100.0" text="Dificultad" />
                        <TableColumn fx:id="colGuia" prefWidth="190.0" text="Guía" />
                     </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
               </children>
            </VBox>
         </content>
      </TitledPane>
      <Label fx:id="lblEstado" minHeight="20.0" styleClass="estado" />
   </children>
</VBox>
